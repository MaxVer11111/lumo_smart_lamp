# Independent OpenAI-compatible Chat Completions endpoint
LLM_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_TIMEOUT=15
# text (JSON requested in the prompt) or json_object (provider supports JSON mode)
LLM_RESPONSE_FORMAT=text
# max_tokens, max_completion_tokens, or empty to omit; empty temperature also omits it
LLM_TOKEN_PARAMETER=max_tokens

# Push-to-talk endpointing. Install with uv sync --extra vad.
VAD_ENABLED=false
VAD_PROVIDER=webrtc
VAD_FRAME_MS=20
VAD_SILENCE_MS=800
VAD_MIN_SPEECH_MS=200
VAD_MAX_SPEECH_SECONDS=15
VAD_PRE_ROLL_MS=300
VAD_WAIT_TIMEOUT=10
VAD_MODE=1

# Bailian Model Studio. API key and URL must belong to the same region/workspace.
ASR_PROVIDER=bailian_http
ASR_MODEL=qwen3-asr-flash
ASR_BASE_URL=
DASHSCOPE_API_KEY=
# For ASR_PROVIDER=dashscope_realtime.
# Blank URL uses the host in ASR_BASE_URL, or the mainland China default if unset.
ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
ASR_REALTIME_URL=
# en, zh, or blank to let the realtime model detect the language.
ASR_LANGUAGE=en
ASR_CHUNK_MS=40
ASR_CONNECT_TIMEOUT=10
ASR_FINAL_TIMEOUT=5
# Optional speech synthesis: openai, dashscope, or mock
# For dashscope, use the workspace's HTTPS /api/v1 base and a Qwen-Audio-TTS model/voice.
TTS_ENABLED=false
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_TIMEOUT=15
TTS_DEVICE=

# Streaming TTS is enabled independently. Set a voice supported by the chosen model.
# Blank URL uses TTS_BASE_URL, then ASR_BASE_URL, then the mainland China default.
TTS_STREAMING_ENABLED=false
TTS_STREAMING_PROVIDER=qwen_realtime
TTS_STREAMING_MODEL=qwen3-tts-flash-realtime
TTS_STREAMING_VOICE=
TTS_STREAMING_URL=
TTS_INITIAL_BUFFER_MS=100
TTS_MAX_BUFFER_MS=2000
TTS_CONNECT_TIMEOUT=10
TTS_STREAMING_TIMEOUT=30

# Reuse stopped audio device handles and enable the in-memory verified motion cache.
AUDIO_REUSE_ENABLED=false
MOTION_CACHE_ENABLED=false

# Physical LED requires an initialized, verified backend. Preview modes simulate it.
LIGHTING_ENABLED=false

# Only used by the original LiveKit applications
OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
