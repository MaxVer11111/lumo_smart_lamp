# Independent OpenAI-compatible Chat Completions endpoint
LLM_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_TIMEOUT=15
# text (JSON requested in the prompt) or json_object (provider supports JSON mode)
LLM_RESPONSE_FORMAT=text
# max_tokens, max_completion_tokens, or empty to omit; empty temperature also omits it
LLM_TOKEN_PARAMETER=max_tokens

# Bailian Model Studio. API key and URL must belong to the same region/workspace.
ASR_MODEL=qwen3-asr-flash
ASR_BASE_URL=
DASHSCOPE_API_KEY=
# Optional speech synthesis: openai, dashscope, or mock
# For dashscope, use the workspace's HTTPS /api/v1 base and a Qwen-Audio-TTS model/voice.
TTS_ENABLED=false
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_TIMEOUT=15
TTS_DEVICE=

# Physical LED requires an initialized, verified backend. Preview modes simulate it.
LIGHTING_ENABLED=false

# Only used by the original LiveKit applications
OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
