{"id":"en-01","text":"Nod your head.","intents":["motion_control"],"actions":[["motion:nod"]]}
{"id":"en-02","text":"Could you give me a little nod?","intents":["motion_control"],"actions":[["motion:nod"]]}
{"id":"en-03","text":"Give me a bob of your head as a sign of agreement.","intents":["motion_control"],"actions":[["motion:nod"]]}
{"id":"en-04","text":"Shake your head from side to side, please.","intents":["motion_control"],"actions":[["motion:headshake"]]}
{"id":"en-05","text":"Show me that you're excited.","intents":["motion_control"],"actions":[["motion:excited"]]}
{"id":"en-06","text":"Can you act curious for me?","intents":["motion_control"],"actions":[["motion:curious"]]}
{"id":"en-07","text":"Look around with your usual gesture.","intents":["motion_control"],"actions":[["motion:scanning"]]}
{"id":"en-08","text":"Hello, Lumo!","intents":["emotion_expression"],"actions":[["motion:happy_wiggle"],["motion:nod"]]}
{"id":"en-09","text":"I finally passed my exam!","intents":["emotion_expression"],"actions":[["motion:excited"],["motion:happy_wiggle"]]}
{"id":"en-10","text":"I finally finished my project!","intents":["emotion_expression"],"actions":[["motion:excited"],["motion:happy_wiggle"]]}
{"id":"en-11","text":"I had a really bad day.","intents":["emotion_expression"],"actions":[["motion:nod"],["motion:sad"]]}
{"id":"en-12","text":"I'm exhausted.","intents":["emotion_expression"],"actions":[["motion:nod"],["motion:sad"]]}
{"id":"en-13","text":"Thank you, Lumo.","intents":["emotion_expression"],"actions":[["motion:nod"]]}
{"id":"en-14","text":"Guess what happened today!","intents":["emotion_expression"],"actions":[["motion:curious"],["motion:nod"]]}
{"id":"en-15","text":"What is gravity?","intents":["emotion_expression"],"actions":[["motion:nod"],["motion:curious"]]}
{"id":"en-16","text":"What is your name?","intents":["emotion_expression"],"actions":[["motion:nod"],["motion:happy_wiggle"]]}
{"id":"en-17","text":"Why is the sky blue?","intents":["emotion_expression"],"actions":[["motion:nod"],["motion:curious"]]}
{"id":"en-18","text":"Tell me a joke.","intents":["emotion_expression"],"actions":[["motion:happy_wiggle"],["motion:nod"]]}
{"id":"en-19","text":"What does nod mean?","intents":["conversation"],"actions":[[]]}
{"id":"en-20","text":"Turn on the light.","intents":["emotion_expression"],"actions":[["lighting:turn_on","motion:nod"],["lighting:turn_on","motion:curious"]]}
{"id":"en-21","text":"It's too dark here.","intents":["emotion_expression"],"actions":[["lighting:increase_brightness","motion:nod"],["lighting:increase_brightness","motion:curious"]]}
{"id":"en-22","text":"Make it a little dimmer.","intents":["emotion_expression"],"actions":[["lighting:decrease_brightness","motion:nod"],["lighting:decrease_brightness","motion:curious"]]}
{"id":"en-23","text":"Set the brightness to 50%.","intents":["emotion_expression"],"actions":[["lighting:set_brightness:50","motion:nod"],["lighting:set_brightness:50","motion:curious"]]}
{"id":"en-24","text":"Switch to reading mode.","intents":["emotion_expression"],"actions":[["lighting:reading_mode","motion:nod"],["lighting:reading_mode","motion:curious"]]}
{"id":"en-25","text":"Turn the light off.","intents":["emotion_expression"],"actions":[["lighting:turn_off","motion:nod"],["lighting:turn_off","motion:curious"]]}
{"id":"en-26","text":"Increase the current brightness by 10 percentage points.","intents":["emotion_expression"],"actions":[["lighting:increase_brightness:10","motion:nod"],["lighting:increase_brightness:10","motion:curious"]]}
{"id":"en-27","text":"Nod your head and turn on your light.","intents":["combined_control"],"actions":[["motion:nod","lighting:turn_on"]]}
{"id":"en-28","text":"Don't nod your head.","intents":["no_action","conversation"],"actions":[[]]}
{"id":"en-29","text":"Don't move.","intents":["stop"],"actions":[["stop"]]}
{"id":"en-30","text":"What happens if you nod?","intents":["conversation","no_action"],"actions":[[]]}
{"id":"en-31","text":"Someone told me to shake my head.","intents":["conversation","no_action"],"actions":[[]]}
{"id":"en-32","text":"I'm not happy today.","intents":["emotion_expression"],"actions":[["motion:nod"],["motion:sad"]]}
{"id":"en-33","text":"I said ‘nod’ as an example.","intents":["conversation","no_action"],"actions":[[]]}
{"id":"en-34","text":"Move somehow.","intents":["conversation","no_action"],"actions":[[]]}
{"id":"en-35","text":"Do it again.","intents":["conversation","no_action"],"actions":[[]]}
{"id":"en-36","text":"What did I just say?","intents":["emotion_expression"],"actions":[["motion:curious"],["motion:nod"]]}
{"id":"en-37","text":"Remember my name.","intents":["emotion_expression"],"actions":[["motion:nod"]]}
{"id":"en-38","text":"What did we talk about yesterday?","intents":["emotion_expression"],"actions":[["motion:curious"],["motion:nod"]]}
